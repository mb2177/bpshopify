# Адрес сайта, который будет в ссылках из Telegram (https://ваш-домен или http://IP)
SITE_URL=https://research.example.com
# Домен для автоматического HTTPS (оставьте пустым, если домена нет)
SITE_ADDRESS=research.example.com

# Вход на сайт (владелец)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=придумайте-длинный-пароль
SECRET_KEY=случайная-строка-40-символов

# Telegram: токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Claude API (console.anthropic.com) — исследование и веб-поиск
ANTHROPIC_API_KEY=
MODEL_RESEARCH=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5

# Необязательно: голосовые сообщения (≈ $0.006/мин)
OPENAI_API_KEY=

# Тестовый режим без API (все данные — ДЕМО). На боевом сервере 0.
FAKE_LLM=0
